/* ============================================================
   OBJECT INTERACTIONS
   ============================================================
   Small taps that make the room feel alive. None of these change
   anything else in the library, and none of them are required —
   Hailey can ignore every object here and the library works
   exactly the same.
   ============================================================ */

// Used by the letter system and the special book: gives an element
// a brief "picked up" wiggle before running whatever happens next.
function wiggleThenRun(el, callback) {
  el.classList.add("wiggling");
  el.addEventListener("animationend", () => {
    el.classList.remove("wiggling");
    callback();
  }, { once: true });
}

// Wires up one tappable object in a room illustration.
// - pass { toggleClass: "lamp-off" } for something with an on/off state (a lamp)
// - pass { discovery: "some text" } for a small optional discovery
// - pass nothing for something that just gives a one-off reaction (a plant)
function setupTappableObject(id, options = {}) {
  const el = document.getElementById(id);
  if (!el) return;

  const activate = () => {
    if (options.toggleClass) {
      el.classList.toggle(options.toggleClass);
    } else {
      el.classList.add("object-nudged");
      el.addEventListener("animationend", () => {
        el.classList.remove("object-nudged");
      }, { once: true });
    }
    if (options.discovery) {
      showDiscovery(options.discovery);
    }
  };

  el.addEventListener("click", activate);
  el.addEventListener("keydown", (event) => {
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      activate();
    }
  });
}

/* ============================================================
   SMALL DISCOVERIES
   ============================================================
   A few optional, easy-to-miss details scattered around the
   library — tapping the creator plaque, the bench in the
   Gallery, or the books on the Reading Room table. None of them
   unlock anything or are required; they're just there for
   Hailey to stumble onto if she's curious. Add more the same
   way: call showDiscovery() with a short line of text.
   ============================================================ */
let discoveryHideTimer = null;

function showDiscovery(text) {
  const toast = document.getElementById("discovery-toast");
  document.getElementById("discovery-toast-text").textContent = text;
  toast.hidden = false;
  toast.classList.remove("discovery-toast-hiding");

  clearTimeout(discoveryHideTimer);
  discoveryHideTimer = setTimeout(hideDiscovery, 4200);
}

function hideDiscovery() {
  const toast = document.getElementById("discovery-toast");
  if (toast.hidden) return;
  toast.classList.add("discovery-toast-hiding");
  toast.addEventListener("animationend", () => {
    toast.hidden = true;
    toast.classList.remove("discovery-toast-hiding");
  }, { once: true });
}


/* ============================================================
   ANIMATIONS
   ============================================================
   Most of the "alive" feeling (dust drifting, curtains swaying,
   rain flickering, spotlights breathing, room fades) runs
   entirely in style.css as CSS animations, so there's nothing to
   wire up here in script.js. This section exists so a future
   animation that DOES need JavaScript has an obvious home.
   ============================================================ */


/* ============================================================
   MODAL HELPERS (shared by letter / book / librarian / music / photo)
   ============================================================ */
let lastFocusedBeforeModal = null;

function openModal(name) {
  lastFocusedBeforeModal = document.activeElement;
  const modal = document.getElementById(`modal-${name}`);
  modal.hidden = false;
  // move focus into the dialog so keyboard and screen-reader users
  // land somewhere sensible instead of staying on the page behind it
  modal.querySelector(".modal-panel").focus({ preventScroll: true });
}
function closeModal(name) {
  const modal = document.getElementById(`modal-${name}`);
  const panel = modal.querySelector(".modal-panel");
  panel.classList.add("modal-panel-closing");
  panel.addEventListener("animationend", () => {
    panel.classList.remove("modal-panel-closing");
    modal.hidden = true;
    // send focus back to whatever was tapped/focused to open this modal
    if (lastFocusedBeforeModal && document.body.contains(lastFocusedBeforeModal)) {
      lastFocusedBeforeModal.focus({ preventScroll: true });
    }
  }, { once: true });
}


