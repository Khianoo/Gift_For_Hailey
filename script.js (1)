  // Music setup runs last, and wrapped in try/catch: some preview tools
  // and locked-down browser settings block audio/storage features
  // entirely. If that ever throws, everything above this line — every
  // room, every letter, every close button — still works perfectly.
  try {
    document.getElementById("btn-music-playpause").addEventListener("click", togglePlayPause);
    document.getElementById("btn-music-prev").addEventListener("click", playPrevTrack);
    document.getElementById("btn-music-next").addEventListener("click", playNextTrack);
    document.getElementById("btn-music-mute").addEventListener("click", toggleMute);
    document.getElementById("music-volume").addEventListener("input", (event) => {
      setVolume(parseFloat(event.target.value));
    });
    initMusicSystem();
  } catch (error) {
    console.warn("Music system couldn't start:", error);
  }
});