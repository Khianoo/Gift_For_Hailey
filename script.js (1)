/* ============================================================
   ROOM / AREA MANAGEMENT
   ============================================================ */
function enterLibrary() {
  const entrance = document.getElementById("view-entrance");
  entrance.classList.add("entrance-leaving");
  entrance.addEventListener("animationend", () => {
    entrance.hidden = true;
    document.getElementById("app").hidden = false;
    goToView("main-library");
  }, { once: true });
}

function goToView(viewName) {
  const nextEl = document.getElementById(`view-${viewName}`);
  const currentEl = document.getElementById(`view-${state.currentView}`);

  if (currentEl && currentEl !== nextEl) {
    currentEl.hidden = true;
  }
  state.currentView = viewName;
  nextEl.hidden = false;

  // replay the fade-in even if this room was just visited a moment ago
  nextEl.classList.remove("room-enter");
  void nextEl.offsetWidth; // forces the browser to notice the class was removed
  nextEl.classList.add("room-enter");

  window.scrollTo({ top: 0, behavior: "auto" });
}


/* ============================================================
   LETTER SYSTEM
   ============================================================ */
function renderShelves() {
  const container = document.getElementById("shelves-container");
  container.innerHTML = "";

  library.forEach((shelf, shelfIndex) => {
    const shelfEl = document.createElement("div");
    shelfEl.className = "shelf";

    const header = document.createElement("div");
    header.className = "shelf-header";
    header.innerHTML = `
      <div>
        <span class="shelf-name"><span class="shelf-icon">${shelf.icon || ""}</span>${shelf.name}</span>
        <p class="shelf-description">${shelf.description}</p>
      </div>
    `;
    shelfEl.appendChild(header);

    const list = document.createElement("ul");
    list.className = "shelf-letters";
    shelf.letters.forEach((letter, letterIndex) => {
      const li = document.createElement("li");
      const btn = document.createElement("button");
      // cover-0 through cover-5: purely visual, cycles so each "book" on the
      // shelf gets a slightly different cover color (see style.css)
      const coverClass = `cover-${(shelfIndex + letterIndex) % 6}`;
      btn.className = `letter-button ${coverClass}`;
      btn.type = "button";
      btn.textContent = letter.title;
      btn.addEventListener("click", () => wiggleThenRun(btn, () => openShelfLetter(shelfIndex, letterIndex)));
      li.appendChild(btn);
      list.appendChild(li);
    });
    shelfEl.appendChild(list);

    container.appendChild(shelfEl);
  });
}

function renderReadingRoom() {
  const container = document.getElementById("reading-room-container");
  container.innerHTML = "";

  readingRoom.forEach((letter, index) => {
    const btn = document.createElement("button");
    btn.className = `letter-button cover-${index % 6}`;
    btn.type = "button";
    btn.textContent = letter.title;
    btn.addEventListener("click", () => wiggleThenRun(btn, () => openReadingRoomLetter(index)));
    container.appendChild(btn);
  });
}

function openShelfLetter(shelfIndex, letterIndex) {
  state.openLetterSource = "shelf";
  state.openShelfIndex = shelfIndex;
  state.openLetterIndex = letterIndex;
  displayLetter(library[shelfIndex].letters[letterIndex]);
}

function openReadingRoomLetter(letterIndex) {
  state.openLetterSource = "reading-room";
  state.openShelfIndex = null;
  state.openLetterIndex = letterIndex;
  displayLetter(readingRoom[letterIndex]);
}

function displayLetter(letter) {
  document.getElementById("letter-title").textContent = letter.title;
  document.getElementById("letter-message").textContent = letter.message;

  const imageWrap = document.getElementById("letter-image-wrap");
  const image = document.getElementById("letter-image");
  if (letter.image) {
    image.src = letter.image;
    image.alt = letter.title;
    imageWrap.hidden = false;
    // if the file can't be found, hide it quietly instead of showing a broken-image icon
    image.onerror = () => { imageWrap.hidden = true; };
  } else {
    imageWrap.hidden = true;
  }

  updateLetterNavButtons();
  openModal("letter");
}

function updateLetterNavButtons() {
  const prevBtn = document.getElementById("btn-letter-prev");
  const nextBtn = document.getElementById("btn-letter-next");
  const list = state.openLetterSource === "shelf"
    ? library[state.openShelfIndex].letters
    : readingRoom;

  prevBtn.disabled = state.openLetterIndex <= 0;
  nextBtn.disabled = state.openLetterIndex >= list.length - 1;
}

function showPrevLetter() {
  if (state.openLetterIndex <= 0) return;
  state.openLetterIndex -= 1;
  const list = state.openLetterSource === "shelf"
    ? library[state.openShelfIndex].letters
    : readingRoom;
  displayLetter(list[state.openLetterIndex]);
}

function showNextLetter() {
  const list = state.openLetterSource === "shelf"
    ? library[state.openShelfIndex].letters
    : readingRoom;
  if (state.openLetterIndex >= list.length - 1) return;
  state.openLetterIndex += 1;
  displayLetter(list[state.openLetterIndex]);
}

