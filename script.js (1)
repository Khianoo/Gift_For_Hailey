/* ============================================================
   GALLERY SYSTEM
   ============================================================ */
function renderGallery() {
  const container = document.getElementById("gallery-container");
  container.innerHTML = "";

  gallery.forEach((cat, catIndex) => {
    const section = document.createElement("div");
    section.className = "gallery-category";

    const heading = document.createElement("h3");
    heading.textContent = cat.category;
    section.appendChild(heading);

    if (cat.photos.length === 0) {
      const empty = document.createElement("p");
      empty.className = "gallery-empty";
      empty.textContent = "No photos here yet — add some in script.js when you're ready.";
      section.appendChild(empty);
    } else {
      const grid = document.createElement("div");
      grid.className = "gallery-grid";
      cat.photos.forEach((photo, photoIndex) => {
        const frame = document.createElement("button");
        frame.className = "gallery-frame";
        frame.type = "button";

        const img = document.createElement("img");
        img.src = photo.image;
        img.alt = photo.caption || cat.category;
        img.loading = "lazy";
        // a missing photo file should never break the page — just
        // quietly drop that one frame instead of showing it broken
        img.addEventListener("error", () => frame.remove());
        frame.appendChild(img);

        if (photo.caption) {
          const caption = document.createElement("p");
          caption.className = "gallery-caption";
          caption.textContent = photo.caption;
          frame.appendChild(caption);
        }

        frame.addEventListener("click", () => wiggleThenRun(frame, () => openPhoto(catIndex, photoIndex)));
        grid.appendChild(frame);
      });
      section.appendChild(grid);
    }

    container.appendChild(section);
  });
}

function openPhoto(catIndex, photoIndex) {
  const photo = gallery[catIndex].photos[photoIndex];
  if (!photo) return;

  const image = document.getElementById("photo-image");
  const caption = document.getElementById("photo-caption");
  image.src = photo.image;
  image.alt = photo.caption || gallery[catIndex].category;
  caption.textContent = photo.caption || "";
  caption.hidden = !photo.caption;

  openModal("photo");
}


/* ============================================================
   MUSIC SYSTEM
   ============================================================
   Works entirely from the musicLibrary list near the top of this
   file. If that list is empty, the panel just shows a friendly
   note — nothing else on the site depends on music working.

   Music keeps playing as you move between rooms and open letters
   — nothing here ever pauses it except tapping pause yourself.
   A missing or broken audio file shows a small note instead of
   breaking anything.
   ============================================================ */
const audioPlayer = new Audio(); // one shared player, reused for every track

// Some sandboxed preview tools (and private-browsing modes) block
// localStorage entirely and *throw* instead of just returning nothing.
// These two helpers make sure that can never break the rest of the site —
// worst case, your volume/mute choice just won't be remembered next visit.
function safeStorageGet(key) {
  try {
    return localStorage.getItem(key);
  } catch (error) {
    return null;
  }
}
function safeStorageSet(key, value) {
  try {
    localStorage.setItem(key, value);
  } catch (error) {
    // storage isn't available here — nothing to do, and nothing breaks
  }
}

function initMusicSystem() {
  const savedVolume = safeStorageGet("hailey-library-volume");
  const savedMuted = safeStorageGet("hailey-library-muted");
  audioPlayer.volume = savedVolume !== null ? parseFloat(savedVolume) : 0.8;
  audioPlayer.muted = savedMuted === "true";
  document.getElementById("music-volume").value = audioPlayer.volume;
  updateMuteButton();

  audioPlayer.addEventListener("ended", playNextTrack);
  audioPlayer.addEventListener("error", () => {
    document.getElementById("music-error").hidden = false;
  });

  if (musicLibrary.length === 0) {
    document.getElementById("music-empty").hidden = false;
    document.getElementById("music-player-ui").hidden = true;
    return;
  }

  document.getElementById("music-empty").hidden = true;
  document.getElementById("music-player-ui").hidden = false;
  renderMoodChips();
  loadTrack(0, { autoplay: false });
}

// only tracks matching the selected mood chip (or everything, if "All" is picked)
function currentPlaylist() {
  if (!state.musicMood) return musicLibrary;
  const filtered = musicLibrary.filter((track) => track.mood === state.musicMood);
  return filtered.length > 0 ? filtered : musicLibrary;
}

function renderMoodChips() {
  const moods = [...new Set(musicLibrary.map((track) => track.mood).filter(Boolean))];
  const container = document.getElementById("music-mood-chips");
  container.innerHTML = "";
  if (moods.length === 0) return; // no moods given — skip the chips entirely

  const allChip = document.createElement("button");
  allChip.type = "button";
  allChip.className = `music-chip${state.musicMood === null ? " music-chip-active" : ""}`;
  allChip.textContent = "All";
  allChip.addEventListener("click", () => setMood(null));
  container.appendChild(allChip);

  moods.forEach((mood) => {
    const chip = document.createElement("button");
    chip.type = "button";
    chip.className = `music-chip${state.musicMood === mood ? " music-chip-active" : ""}`;
    chip.textContent = mood;
    chip.addEventListener("click", () => setMood(mood));
    container.appendChild(chip);
  });
}

function setMood(mood) {
  state.musicMood = mood;
  renderMoodChips();

  const currentTrack = musicLibrary[state.musicTrackIndex];
  if (mood && currentTrack && currentTrack.mood !== mood) {
    const firstMatch = currentPlaylist()[0];
    loadTrack(musicLibrary.indexOf(firstMatch), { autoplay: state.musicPlaying });
  }
}

function loadTrack(index, { autoplay }) {
  const track = musicLibrary[index];
  if (!track) return;

  state.musicTrackIndex = index;
  document.getElementById("music-error").hidden = true;
  document.getElementById("music-track-title").textContent = track.title;
  document.getElementById("music-track-artist").textContent = track.artist || "";

  audioPlayer.src = track.file;

  if (autoplay) {
    playCurrentTrack();
  } else {
    state.musicPlaying = false;
    updatePlayPauseButton();
  }
}

function playCurrentTrack() {
  audioPlayer.play()
    .then(() => {
      state.musicPlaying = true;
      updatePlayPauseButton();
    })
    .catch(() => {
      // browsers block autoplay until a person interacts with the page —
      // this simply leaves the player paused instead of erroring out
      state.musicPlaying = false;
      updatePlayPauseButton();
    });
}

function togglePlayPause() {
  if (musicLibrary.length === 0) return;
  if (state.musicPlaying) {
    audioPlayer.pause();
    state.musicPlaying = false;
    updatePlayPauseButton();
  } else {
    playCurrentTrack();
  }
}

function playNextTrack() {
  const playlist = currentPlaylist();
  const position = playlist.indexOf(musicLibrary[state.musicTrackIndex]);
  const next = playlist[(position + 1) % playlist.length];
  loadTrack(musicLibrary.indexOf(next), { autoplay: true });
}

function playPrevTrack() {
  const playlist = currentPlaylist();
  const position = playlist.indexOf(musicLibrary[state.musicTrackIndex]);
  const prev = playlist[(position - 1 + playlist.length) % playlist.length];
  loadTrack(musicLibrary.indexOf(prev), { autoplay: true });
}

function updatePlayPauseButton() {
  const playPauseBtn = document.getElementById("btn-music-playpause");
  playPauseBtn.textContent = state.musicPlaying ? "⏸" : "▶";
  playPauseBtn.setAttribute("aria-label", state.musicPlaying ? "Pause" : "Play");

  // a small pulse on the Main Library music icon shows it's playing
  // even when this panel is closed
  document.getElementById("btn-music-player").classList.toggle("music-playing", state.musicPlaying);
}

function setVolume(value) {
  audioPlayer.volume = value;
  audioPlayer.muted = false;
  safeStorageSet("hailey-library-volume", String(value));
  safeStorageSet("hailey-library-muted", "false");
  updateMuteButton();
}

function toggleMute() {
  audioPlayer.muted = !audioPlayer.muted;
  safeStorageSet("hailey-library-muted", String(audioPlayer.muted));
  updateMuteButton();
}

function updateMuteButton() {
  const muteBtn = document.getElementById("btn-music-mute");
  muteBtn.textContent = audioPlayer.muted ? "🔇" : "🔊";
  muteBtn.setAttribute("aria-label", audioPlayer.muted ? "Unmute" : "Mute");
}

function openMusicPlayer() {
  openModal("music");
}


